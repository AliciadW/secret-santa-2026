# Netlify supplies the database connection automatically on deploy and in Netlify Dev.
# For a standalone local Postgres instance only, set these in an ignored .env file:
# NETLIFY_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/secret_santa
# NETLIFY_DB_DRIVER=server

# Optional invitation emails (server only). Use a verified Resend sender domain.
# RESEND_API_KEY=re_...
# EMAIL_FROM=The Secret Santa Club <santa@example.com>
# SITE_URL=https://your-site.example.com
